#!/bin/sh /etc/rc.common
# mihomo 服务（procd）。配置为 /etc/mihomo/config.yaml，本脚本只读不写。
#
# 开机延迟：开机 5 分钟内启动时先等 40 秒，等 USB 与网络初始化完成。每次开机只等一次
# （标记文件 /var/run/mihomo-boot-delay.done）；procd respawn、手动 restart 都不再延迟。
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    # 用 sh -c 包一层并在末尾 exec 内核：进程号不变，procd 仍能 stop / respawn。
    procd_set_param command /bin/sh -c '
        if [ ! -f /var/run/mihomo-boot-delay.done ] && [ "$(cut -d. -f1 /proc/uptime)" -lt 300 ]; then
            : > /var/run/mihomo-boot-delay.done
            logger -t mihomo "开机延迟 40 秒后再启动内核（等 USB/网络初始化完）"
            sleep 40
        fi
        exec /etc/mihomo/mihomo -d /etc/mihomo
    '
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="65535 65535"
    procd_close_instance
}
