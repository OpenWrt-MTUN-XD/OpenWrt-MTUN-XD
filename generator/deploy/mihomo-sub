#!/bin/sh
# 配置工具「机场订阅」的一次性拉取接口。
#
# 每次请求只做「一跳」：
#   X-Sub-Route: direct  → 强制从 WAN 出去，绕开 TUN / fake-ip
#   X-Sub-Route: tun     → 优先经本机 mihomo 的 mixed/socks/http 口
#                          没有本地端口时退化为 tun-plain（靠 TUN 接管）
#
# 两跳由前端编排；这个脚本绝不自己重试第二次。
#
# 调用：POST /cgi-bin/mihomo-sub
#       Authorization: Bearer <config.yaml 里的 secret>
#       Content-Type: text/plain
#       body: 订阅 URL
#
# 边界：
#   - 只允许 http/https，且重定向也必须是 http/https
#   - URL 请求体最多 4 KiB
#   - 响应最多 4 MiB
#   - 最多跟随 3 次重定向
#   - 连接超时 6 秒，总超时 25 秒
#   - 拒绝本机 / 内网 / 链路本地 / ULA 目标（SSRF 防护）
#   - 不保存 URL，不写日志，不缓存内容
#   - 认证复用 mihomo 自己的 secret，不新增钥匙

CONFIG=${MIHOMO_SUB_CONFIG:-/etc/mihomo/config.yaml}
MAX_BYTES=4194304
MAX_URL=4096
SUB_TMP=''
ERR_TMP=''
ROUTE='direct'
UPSTREAM='000'

# 清理上一次请求被客户端中断时留下的临时文件。UI 是单飞的，/tmp 下这些前缀
# 只可能是本接口自己的；不清理会让 ls /tmp/mihomo-sub* 看起来永远不干净。
find /tmp -maxdepth 1 -name 'mihomo-sub.*' -mmin +5 -delete 2>/dev/null
find /tmp -maxdepth 1 -name 'mihomo-sub-err.*' -mmin +5 -delete 2>/dev/null

cleanup_sub_files() {
    [ -n "$SUB_TMP" ] && rm -f "$SUB_TMP"
    [ -n "$ERR_TMP" ] && rm -f "$ERR_TMP"
}
trap cleanup_sub_files EXIT
trap 'cleanup_sub_files; exit 130' INT TERM

api_secret() {
    sed -n 's/^secret:[[:space:]]*//p' "$CONFIG" | head -1 | tr -d '"'\'' '
}

cors() {
    # 只反射与 HTTP_HOST 主名相同的 Origin；不匹配就不输出该头，避免开放代理。
    if [ -n "${HTTP_ORIGIN:-}" ]; then
        oh=$(printf '%s' "$HTTP_ORIGIN" | sed 's#^[^:]*://##; s#/.*##; s#:.*##')
        hh=$(printf '%s' "${HTTP_HOST:-}" | sed 's#:[0-9]*$##')
        oh=$(printf '%s' "$oh" | tr 'A-Z' 'a-z')
        hh=$(printf '%s' "$hh" | tr 'A-Z' 'a-z')
        if [ -n "$oh" ] && [ "$oh" = "$hh" ]; then
            printf 'Access-Control-Allow-Origin: %s\r\n' "$HTTP_ORIGIN"
        fi
    fi
    printf 'Access-Control-Allow-Methods: POST, OPTIONS\r\n'
    printf 'Access-Control-Allow-Headers: Content-Type, Authorization, X-Sub-Route\r\n'
    printf 'Access-Control-Expose-Headers: X-Sub-Reason, X-Sub-Route, X-Sub-Upstream\r\n'
    printf 'X-Content-Type-Options: nosniff\r\n'
    printf 'Vary: Origin\r\n'
}

fail() {
    printf 'Status: %s\r\n' "$1"
    [ -n "${3:-}" ] && printf 'X-Sub-Reason: %s\r\n' "$3"
    printf 'X-Sub-Route: %s\r\n' "$ROUTE"
    printf 'X-Sub-Upstream: %s\r\n' "$UPSTREAM"
    printf 'Content-Type: text/plain; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    cors
    printf '\r\n'
    printf '%s\n' "$2"
    exit 0
}

# OPTIONS 不能走 fail()：它必须是 204、无 Content-Type、无 body。
if [ "${REQUEST_METHOD:-}" = 'OPTIONS' ]; then
    printf 'Status: 204 No Content\r\n'
    cors
    printf '\r\n'
    exit 0
fi
[ "${REQUEST_METHOD:-}" = 'POST' ] || fail '405 Method Not Allowed' 'only POST'

# ── 路由与认证 ─────────────────────────────────────────────────
# uhttpd 不会把自定义 X-Sub-Route 头传进 CGI；Authorization 才会。
# 所以同时支持头部（直调 / 测试）和 query（真实 uhttpd 路径）。
route=$(printf '%s' "${HTTP_X_SUB_ROUTE:-}" | tr 'A-Z' 'a-z')
case "$route" in
    direct|tun) ;;
    *)
        route=$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/.*route=\([^&]*\).*/\1/p' | head -1 | tr 'A-Z' 'a-z')
        ;;
esac
case "$route" in direct|tun) ;; *) route=direct ;; esac
ROUTE="$route"

want=$(api_secret)
if [ -z "$want" ]; then
    fail '403 Forbidden' 'mihomo 没设 secret' 'no-secret'
fi

given=$(printf '%s' "${HTTP_AUTHORIZATION:-}" | sed -n 's/^[Bb]earer[[:space:]]*//p')
if [ -z "$given" ]; then
    fail '401 Unauthorized' 'missing Authorization' 'no-auth'
fi
if [ "$given" != "$want" ]; then
    fail '403 Forbidden' 'bad secret' 'bad-secret'
fi

# ── 读取 URL ───────────────────────────────────────────────────
len=${CONTENT_LENGTH:-}
case "$len" in
    ''|*[!0-9]*) fail '400 Bad Request' 'missing or invalid Content-Length' ;;
esac
[ "$len" -gt "$MAX_URL" ] && fail '413 Payload Too Large' '订阅 URL 过长'

url=$(dd bs=1 count="$len" 2>/dev/null)
url=$(printf '%s' "$url" | tr -d '\r\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
[ -n "$url" ] || fail '400 Bad Request' '订阅 URL 为空'

case "$url" in
    http://*|https://*) ;;
    *) fail '400 Bad Request' '订阅 URL 只支持 http/https' ;;
esac
# S-UI 的订阅名称允许空格；HTTP URL 里必须编码成 %20。
url=$(printf '%s' "$url" | sed 's/ /%20/g')
case "$url" in
    *[[:space:]]*) fail '400 Bad Request' '订阅 URL 不能包含制表符或换行' ;;
esac

# ── SSRF：只允许公网主机 ──────────────────────────────────────
# 代理地址 127.0.0.1 不在这里判，判据只针对目标 URL。
rest=$(printf '%s' "$url" | sed 's#^[A-Za-z][A-Za-z0-9+.-]*://##; s#[/?#].*$##; s#^.*@##')
host=$(printf '%s' "$rest" | sed 's#^\[##; s#\].*$##; s#:.*$##')
case "$rest" in
    \[*\]:*) port=${rest##*]:} ;;
    \[*\])   port='' ;;
    *:*)     port=${rest##*:} ;;
    *)       port='' ;;
esac
case "$url" in https://*) default_port=443 ;; *) default_port=80 ;; esac
case "$port" in ''|*[!0-9]*) port="$default_port" ;; esac
case "$host" in
    ''|*[!A-Za-z0-9._:-]*) fail '400 Bad Request' '订阅 URL 主机名非法' 'ssrf' ;;
esac
host=$(printf '%s' "$host" | tr 'A-Z' 'a-z' | sed 's/\.$//')

ssrf=0
case "$host" in
    localhost|localhost.localdomain) ssrf=1 ;;
esac
case "$host" in
    *:*) # 只有 IPv6 才按这些前缀判，别误伤 fc.example.com
        case "$host" in
            ::1|0:0:0:0:0:0:0:1) ssrf=1 ;;
            fe8*|fe9*|fea*|feb*) ssrf=1 ;;
            fc*|fd*) ssrf=1 ;;
        esac
        ;;
esac
case "$host" in
    127.*|10.*|192.168.*|169.254.*) ssrf=1 ;;
esac
if [ "$ssrf" = 0 ]; then
    printf '%s\n' "$host" | awk -F. '
        NF == 4 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ {
            for (i=1; i<=4; i++) {
                if ($i + 0 > 255) exit 2
            }
            if ($1 == 127 || $1 == 10 || ($1 == 192 && $2 == 168) || ($1 == 169 && $2 == 254)) exit 0
            if ($1 == 172 && $2 >= 16 && $2 <= 31) exit 0
            exit 1
        }
        { exit 1 }
    '
    awk_rc=$?
    if [ "$awk_rc" = 0 ]; then
        ssrf=1
    elif [ "$awk_rc" = 2 ]; then
        fail '400 Bad Request' '订阅 URL 主机名非法' 'ssrf'
    fi
fi
[ "$ssrf" = 1 ] && fail '400 Bad Request' '不支持内网或本机地址' 'ssrf'

# ── 临时空间 ───────────────────────────────────────────────────
avail=$(df -k /tmp 2>/dev/null | awk 'NR == 2 { print $4; exit }')
case "$avail" in
    ''|*[!0-9]*) ;;
    *) [ "$avail" -lt 8192 ] && fail '507 Insufficient Storage' '路由器临时空间不足' 'no-space' ;;
esac

# ── 一跳 ───────────────────────────────────────────────────────
umask 077
SUB_TMP=$(mktemp /tmp/mihomo-sub.XXXXXX 2>/dev/null) || \
    fail '500 Internal Server Error' '无法创建临时文件'
ERR_TMP=$(mktemp /tmp/mihomo-sub-err.XXXXXX 2>/dev/null) || \
    fail '500 Internal Server Error' '无法创建临时文件'

# 有些精简 libcurl 没编 zlib，--compressed 会直接 rc=2；有就启用，没就退回原样。
COMPRESSED_OPT=''
curl --compressed --version >/dev/null 2>&1 && COMPRESSED_OPT='--compressed'

set -- -sS -L $COMPRESSED_OPT \
    --proto '=http,https' \
    --proto-redir '=http,https' \
    --max-redirs 3 \
    --connect-timeout 6 \
    --max-time 25 \
    --speed-limit 10 \
    --speed-time 20 \
    --max-filesize "$MAX_BYTES" \
    -A 'mihomo' \
    -H 'Cache-Control: no-cache'

if [ "$route" = 'direct' ]; then
    # 系统 DNS 被 fake-ip 接管；必须用指定 resolver 取真实 IPv4。
    ip=''
    for dns in 223.5.5.5 119.29.29.29; do
        ip=$(nslookup "$host" "$dns" 2>/dev/null | awk '
            /^Name:/ { found=1; next }
            found && /^Address: / { print $2; exit }
        ')
        [ -n "$ip" ] && break
    done
    # 去掉 IPv6 结果；直连这里只处理 IPv4。
    case "$ip" in *:*) ip='' ;; esac
    # mihomo 的 DNS 劫持会把 nslookup 也变成 fake-ip；198.18/198.19 不能拿去直连。
    case "$ip" in 198.18.*|198.19.*|0.0.0.0) ip='' ;; esac

    wan=$(ip -4 route show table main 2>/dev/null | awk '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
    case "$wan" in *tun*|*Tun*|*TUN*|Meta) wan='' ;; esac
    # nslookup 被 fake-ip 接管时，改用 WAN 上的 DoH 取真实 IPv4。
    if [ -n "$wan" ] && [ -z "$ip" ]; then
        doh=$(curl -4 -sS -m 8 --interface "$wan" -k \
            "https://223.5.5.5/resolve?name=$host&type=A" 2>/dev/null)
        ip=$(printf '%s' "$doh" | sed -n 's/.*"type":1,"data":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
    fi

    if [ -z "$ip" ] || [ -z "$wan" ]; then
        fail '409 Conflict' '直连不可用（解析或 WAN 接口缺失）' 'direct-unavailable'
    fi

    set -- "$@" --resolve "$host:$port:$ip" --interface "$wan"
    ROUTE='direct'
else
    # 跳2：优先本地监听口；端口全部无效就靠 TUN 自然接管。
    mp=$(sed -n 's/^mixed-port:[[:space:]]*//p' "$CONFIG" | head -1 | tr -d '" ')
    sp=$(sed -n 's/^socks-port:[[:space:]]*//p' "$CONFIG" | head -1 | tr -d '" ')
    hp=$(sed -n 's/^port:[[:space:]]*//p' "$CONFIG" | head -1 | tr -d '" ')
    proxy_opt=''
    proxy_arg=''
    if [ -n "$mp" ] && [ "$mp" -gt 0 ] 2>/dev/null; then
        proxy_opt='--proxy'
        proxy_arg="http://127.0.0.1:$mp"
        ROUTE='tun-port'
    elif [ -n "$sp" ] && [ "$sp" -gt 0 ] 2>/dev/null; then
        proxy_opt='--socks5-hostname'
        proxy_arg="127.0.0.1:$sp"
        ROUTE='tun-port'
    elif [ -n "$hp" ] && [ "$hp" -gt 0 ] 2>/dev/null; then
        proxy_opt='--proxy'
        proxy_arg="http://127.0.0.1:$hp"
        ROUTE='tun-port'
    else
        ROUTE='tun-plain'
    fi
    if [ -n "$proxy_opt" ]; then
        set -- "$@" "$proxy_opt" "$proxy_arg"
    fi
fi

set -- "$@" --output "$SUB_TMP" --write-out '%{http_code}' -- "$url"
code=$(curl "$@" 2>"$ERR_TMP")
rc=$?
UPSTREAM=${code:-000}
rm -f "$ERR_TMP"
ERR_TMP=''

if [ "$rc" -ne 0 ]; then
    case "$rc" in
        1)    fail '502 Bad Gateway' '订阅重定向到了不支持的协议（只允许 http/https）' 'redir' ;;
        6)    fail '502 Bad Gateway' '订阅域名解析失败' 'dns' ;;
        7)    fail '502 Bad Gateway' '连接订阅服务器失败' 'connect' ;;
        28)   fail '504 Gateway Timeout' '订阅拉取超时' 'timeout' ;;
        35|60) fail '502 Bad Gateway' '订阅 TLS 证书校验失败' 'tls' ;;
        47)   fail '502 Bad Gateway' '订阅重定向次数过多，或目标协议不是 http/https（只允许 http/https）' 'redir' ;;
        63)   fail '413 Payload Too Large' '订阅内容超过 4 MiB' 'too-large' ;;
        127)  fail '502 Bad Gateway' '路由器没有 curl' 'no-curl' ;;
        45)   fail '409 Conflict' '直连不可用（WAN 接口不可绑定）' 'direct-unavailable' ;;
        *)    fail '502 Bad Gateway' "订阅拉取失败（curl $rc）" 'curl' ;;
    esac
fi

case "$code" in
    2??) ;;
    3??) fail '502 Bad Gateway' '订阅重定向到了不支持的协议（只允许 http/https）' 'redir' ;;
    403) fail '502 Bad Gateway' '订阅站拒绝访问（CDN/WAF 拦截或 token 失效）' 'forbidden' ;;
    *) fail '502 Bad Gateway' "订阅返回 HTTP $code" 'http' ;;
esac

size=$(wc -c < "$SUB_TMP" | tr -d ' ')
[ "$size" -gt "$MAX_BYTES" ] && fail '413 Payload Too Large' '订阅内容超过 4 MiB' 'too-large'
[ "$size" -eq 0 ] && fail '502 Bad Gateway' '订阅返回空内容' 'empty'

printf 'Status: 200 OK\r\n'
printf 'X-Sub-Route: %s\r\n' "$ROUTE"
printf 'X-Sub-Upstream: %s\r\n' "$UPSTREAM"
printf 'Content-Type: text/plain; charset=utf-8\r\n'
printf 'Content-Length: %s\r\n' "$size"
printf 'Cache-Control: no-store\r\n'
cors
printf '\r\n'
cat "$SUB_TMP"
