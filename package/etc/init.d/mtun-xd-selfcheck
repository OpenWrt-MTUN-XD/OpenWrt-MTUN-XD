#!/bin/sh /etc/rc.common
# 开机自检：固件升级重启后自动补齐。
#
# 固件升级最常见的后遗症是包的登记被刷掉 —— 文件还在磁盘上、内核照跑，
# 但 `apk info -e` 说没装：版本号读不出、菜单指着被删的旧文件（404）、升级/卸载也拿不到包。
#
# 这里在开机后补一次：登记丢了就重装，核心/面板缺了就 setup，内核没跑就起一次。
# 一切正常时什么都不做、一个字都不打（日志只在真修东西时才有内容）。
# ⚠️ 后台跑 + 先等 25 秒：不拖慢开机，也给网络/procd 留出就位时间。

START=99
STOP=01

boot() {
    ( sleep 25; /usr/sbin/mtun-xd selfcheck ) >>/tmp/mtun-xd.boot.log 2>&1 &
}

start() { boot; }
